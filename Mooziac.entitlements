<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime Capabilities -->
    <!-- Required for WKWebView JIT and audio engines -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    
    <!-- Outbound network access for audio streaming and YouTube Music -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- Local server access for Discord RPC if needed -->
    <key>com.apple.security.network.server</key>
    <true/>
    
    <!-- Audio hardware and output access -->
    <key>com.apple.security.device.audio-input</key>
    <false/>
</dict>
</plist>
